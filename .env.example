# 필요한 환경변수 목록. 값은 적지 않는다. 실제 값은 .env(로컬) 또는 Secret Manager(GCP)에 둔다.

# --- backend (backend/app/config.py가 읽는다) ---
APP_ENV=                      # local / test / dev / production
OPENROUTER_API_KEY=           # OpenRouter Key 원문. DB·응답·로그에 넣지 않는다
INGEST_TOKEN=                 # 기록 API(X-Patron-Ingest-Token) 인증 토큰
ALLOWED_ORIGIN=               # 상태 변경 요청을 허용할 프론트 주소 (예: http://localhost:5173)
SESSION_COOKIE_SECURE=
OPENROUTER_TIMEOUT_SECONDS=   # 모델별 호출 Timeout(초)

# --- frontend (nginx) ---
BACKEND_URL=                  # /api/* 를 프록시할 backend 주소

# --- database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=                 # postgresql+psycopg://USER:PASSWORD@HOST:PORT/patron
TEST_DATABASE_URL=            # postgresql+psycopg://USER:PASSWORD@HOST:PORT/patron_test (테스트는 patron_test만 쓴다)