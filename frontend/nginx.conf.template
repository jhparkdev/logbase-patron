# Docker 컨테이너 시작 시 ${...}에 환경 변수 값을 넣어 nginx 설정을 생성한다.
# 로컬에서는 Docker Compose의 backend에 연결하고, 배포에서는 실제 Backend 주소를 사용한다.

server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Backend 주소가 변경되더라도 새 주소를 찾을 수 있도록 DNS 설정
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # /api/로 시작하는 요청은 React가 아닌 FastAPI로 전달
    location /api/ {
        # 실행 환경에 따라 Backend 주소 변경
        set $backend "${BACKEND_URL}";

        # 요청 경로(/api/...)를 유지하며 Backend로 전달
        proxy_pass $backend;

        # Backend가 요청받을 호스트 정보 설정
        proxy_set_header Host ${BACKEND_HOST};

        # HTTPS Backend 연결 시 서버 이름 확인에 사용
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};

        # 원래 요청을 보낸 클라이언트의 IP 정보 전달
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # JavaScript, CSS 등 정적 파일 처리
    location /assets/ {
        # 요청한 파일이 없으면 404 반환
        try_files $uri =404;

        # 파일 이름에 해시가 있으므로 브라우저에서 장기간 캐싱
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # React 화면 라우팅 처리
    location / {
        # 직접 URL 접속이나 새로고침 시 React 진입 파일 제공
        try_files $uri /index.html;

        # 배포 후 최신 파일을 확인할 수 있도록 캐시 재검증
        add_header Cache-Control "no-cache";
    }
}