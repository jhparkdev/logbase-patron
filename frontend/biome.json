{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": [
      "**",
      "!src/routeTree.gen.ts",
      "!src/shared/api/schema.d.ts",
      "!openapi.json",
      "!pnpm-lock.yaml",
      "!src/assets",
      "!**/*.md"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
